                   Practice questions and answers using the same database as from Customer and Order Analysis V2

-- Query 1
-- How many of each type of headphone were sold in February?


SELECT Product,
       SUM(Quantity) Quantity
  FROM BIT_DB.FebSales
 WHERE Product LIKE '%Headphones%' AND
       length(orderid) = 6 AND
       orderid <> 'Order ID'
 GROUP BY Product;
 
-- Query 2
-- What was the average amount spent per account in February?

SELECT AVG(quantity * price) 
  FROM BIT_DB.FebSales fsales
       JOIN
       BIT_DB.customers cust ON fsales.orderID = cust.order_id
 WHERE length(orderid) = 6 AND
       orderid <> 'Order ID';

      
-- Query 3
-- Find order ids from Georgia (GA) where the order has an average price greater than $1,000. Only find orders from dates beginning with ‘04/1’. Assume that the dates are stored in the MM/DD/YY HH:MM format.

SELECT orderID
FROM BIT_DB.AprSales
WHERE orderdate LIKE '04/1%' AND location LIKE '%GA%'
GROUP BY orderID
HAVING AVG(Quantity * price) > 1000;


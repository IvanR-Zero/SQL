// Questions with their respective answers

--1. Display which members(first and last name) that have a hotel reservation and are also going to an event.

SELECT vips.member_id ID, vips.first_name FirstName, vips.last_name LastName, reservations.hotel Reservation, vips.event Event
FROM vips INNER JOIN reservations
ON vips.member_ID = reservations.member_id;

--2. Show every event even if they do not have a member going to it.
SELECT events.event_id ID, events.event_name EventName, events.event_type EventType, vips.first_name FirstName, Vips.last_name LastName
FROM vips RIGHT JOIN events
ON vips.event = events.event_id;

--3. Have every hotel shown even if members are not staying in them during their time at the event.
SELECT hotels.hotel_name, reservations.member_id
FROM hotels LEFT JOIN reservations
ON hotels.hotel_id = reservations.hotel;

--4. Display member names(First and last), what event they are staying at, and what hotel they are staying at.
SELECT vips.first_name FirstName, vips.last_name LastName, events.event_name, hotels.hotel_name
FROM vips JOIN events
ON vips.event = events.event_id
	JOIN reservations
    ON vips.member_id = reservations.member_id
    	JOIN hotels
        ON reservations.hotel = hotels.hotel_id;
        
--5. Find out which event and type of even the VIP Sofia Rodriguez is attending.
SELECT event_name, event_type
FROM events
WHERE event_id = (SELECT event FROM vips WHERE first_name = 'Sofia');

--6. Show which vips are being given feedback by, and order them by their respective associations alphabetically
SELECT VIP.association Association, VIP.first_name VipName, Feedback.first_name FeedbackGiver
FROM vips VIP INNER JOIN vips Feedback
ON VIP.member_id = Feedback.provides_feedback_to
ORDER BY association ASC;








// Used to create the database iteself.

CREATE TABLE vips (
     member_id INTEGER PRIMARY KEY
   , last_name TEXT
   , first_name TEXT
   , event INTEGER
   , provides_feedback_to INTEGER
   , association TEXT
   , assoc_type TEXT
   , member_since INTEGER
   );
   
CREATE TABLE reservations ( 
    member_id INTEGER
  , hotel INTEGER
  , welcome_rsvp BIT
  , dinner_rsvp BIT
  );
 
 
CREATE TABLE events (
    event_id INTEGER PRIMARY KEY
  , event_name TEXT
  , event_type TEXT
  );
  

CREATE TABLE hotels (
    hotel_id INTEGER PRIMARY KEY
  , hotel_name TEXT
  , address TEXT
  );


